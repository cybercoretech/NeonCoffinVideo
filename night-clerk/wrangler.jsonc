{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neon-coffin-night-clerk",
  "main": "src/worker.js",
  "account_id": "f770e07e62b976b12330421edcf2a7d9",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SITE_ORIGIN": "https://neoncoffinvideo.site",
    "TIME_ZONE": "America/Los_Angeles",
    "PUBLISH_HOUR": "0"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "BOT_DB",
      "database_name": "neon-coffin-night-clerk",
      "database_id": "70ea1468-48c0-4663-b90b-f5bc1ed50c34",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "COMMAND_LIMITER",
      "namespace_id": "2026100901",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
